# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# Groq is the primary model provider, Gemini is the backup. Both are server-only.
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
AI_TIMEOUT_MS=8000

# Supabase project settings -> API. The anon key is public by design; RLS scopes it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Read by scripts/seed-db.ts and nothing that ships.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# tuning, so the trigger can be loosened from the Vercel dashboard without a rebuild
NEXT_PUBLIC_DEFAULT_LOCATION_SOURCE=sim
NEXT_PUBLIC_DWELL_MS=3000
NEXT_PUBLIC_FACING_TOLERANCE_DEG=60
NEXT_PUBLIC_APPROACH_BUFFER_M=25
NEXT_PUBLIC_DWELL_DRIFT_M=1.5
NEXT_PUBLIC_REARM_BUFFER_M=10
NEXT_PUBLIC_REARM_MS=3000
