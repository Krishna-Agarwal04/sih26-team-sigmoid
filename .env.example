# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.

# --- Gemini -----------------------------------------------------------------
# Free tier, no card. Key from https://aistudio.google.com/apikey
# Server-only. lib/ai/gemini.ts is the sole reader.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash        # drop to gemini-3.5-flash if rate-limited
GEMINI_TIMEOUT_MS=8000               # past this, serve the cached Page result

# --- Supabase ---------------------------------------------------------------
# Project settings -> API. The anon key is public by design; RLS scopes it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Read by scripts/seed-db.ts and nothing that ships.
SUPABASE_SERVICE_ROLE_KEY=

# Project settings -> Database -> Connection string (URI). Used by `supabase db push`.
SUPABASE_DB_URL=

# --- Trigger tuning ---------------------------------------------------------
# These are env vars so the Threshold Crossing can be loosened from the Vercel
# dashboard without a rebuild if the room, projector or a judge's dragging
# makes the defaults too strict. See plan/02-architecture.md section 8.
NEXT_PUBLIC_DEFAULT_LOCATION_SOURCE=sim   # sim | gps
NEXT_PUBLIC_DWELL_MS=3000
NEXT_PUBLIC_FACING_TOLERANCE_DEG=60
NEXT_PUBLIC_APPROACH_BUFFER_M=25
